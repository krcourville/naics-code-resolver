{
  "name": "naics-code-resolver",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cajuncodemonkey/naics-search run build && pnpm --filter naics-resolver run dev",
    "build": "pnpm --filter @cajuncodemonkey/naics-search run build && pnpm --filter naics-resolver run build && rm -rf apps/naics-resolver/dist/data && cp -r packages/naics-search/data apps/naics-resolver/dist/data",
    "preview": "pnpm --filter naics-resolver run preview",
    "test:e2e": "playwright test",
    "infer": "node scripts/infer.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@cajuncodemonkey/naics-search": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
