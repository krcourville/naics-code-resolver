{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@arethetypeswrong/core", "publint"],
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"]
    },
    "apps/naics-resolver": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/naics-search": {
      "entry": ["src/index.ts", "src/naics/fs-provider.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/naics-search-react": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
